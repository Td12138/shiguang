# 食光 · 后端环境变量模板
# 用法：复制为 apps/server/.env 后填写（.env 已在 .gitignore 中，永不入库）
# 只写示例值，禁止提交真实 API Key

# ===== 模型提供方（契约 §7）=====
# 可选：mock | zhipu | dashscope | openai | local
# mock = 内置回放数据，无需任何 Key，全链路可演示（默认）
SHIGUANG_LLM_PROVIDER=mock

# 接口根地址；留空则按 provider 预设：
#   zhipu     → https://open.bigmodel.cn/api/paas/v4
#   dashscope → https://dashscope.aliyuncs.com/compatible-mode/v1
#   openai    → https://api.openai.com/v1
#   local     → http://127.0.0.1:8080/v1
SHIGUANG_LLM_BASE_URL=

# API Key：只从本文件读，禁止入库、禁止打日志（日志只显示 ***末4位）
SHIGUANG_LLM_API_KEY=sk-your-key-here

# 文本模型；留空按预设（zhipu: glm-4-flash / dashscope: qwen-plus）
SHIGUANG_LLM_MODEL=

# 视觉模型（拍照识别）；留空按预设（zhipu: glm-4v-flash / dashscope: qwen-vl-plus）
SHIGUANG_VLM_MODEL=

# ===== 检索向量（契约 §8：none 时只走 FTS5 关键词召回）=====
# 可选：none | api | local（local 指本机 127.0.0.1:8848 的 BGE-M3 服务）
SHIGUANG_EMBEDDING_PROVIDER=none
# SHIGUANG_EMBEDDING_BASE_URL=http://127.0.0.1:8848
# SHIGUANG_EMBEDDING_MODEL=bge-m3

# ===== 服务 =====
# 后端端口（前端 dev 5274 通过 Vite 代理 /api 到这里）
SHIGUANG_PORT=8720
# 监听地址；0.0.0.0 才允许容器/外网访问
SHIGUANG_HOST=127.0.0.1
# 追加允许的跨域来源，逗号分隔；留空用内置的 5274 两项
# SHIGUANG_CORS_ORIGINS=http://127.0.0.1:5274,http://localhost:5274
# 日志级别：DEBUG | INFO | WARNING | ERROR
SHIGUANG_LOG_LEVEL=INFO
# 数据库文件位置（可选，相对 apps/server 或绝对路径；默认 data/app.db，不入库）
# SHIGUANG_DB_PATH=data/app.db

# ---- 发布形态（默认关闭）
SHIGUANG_WEB_DIST=
SHIGUANG_BASIC_AUTH=
SHIGUANG_RATE_LIMIT_PER_MIN=0
# TLS 校验：os=系统信任库 / strict=certifi / off=仅本地开发
SHIGUANG_SSL_VERIFY=os
