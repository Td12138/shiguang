[
  {
    "id": "r_001",
    "title": "番茄炒蛋",
    "ingredients": [
      {"name": "番茄", "qty": 2, "unit": "个", "optional": false},
      {"name": "鸡蛋", "qty": 3, "unit": "个", "optional": false},
      {"name": "小葱", "qty": 1, "unit": "根", "optional": true},
      {"name": "食用油", "qty": 2, "unit": "勺", "optional": false},
      {"name": "盐", "qty": 2, "unit": "克", "optional": true},
      {"name": "白糖", "qty": 3, "unit": "克", "optional": true}
    ],
    "steps": [
      "番茄去蒂切滚刀块，鸡蛋打散加一小撮盐搅匀。",
      "锅烧热放 1 勺油，倒入蛋液，凝固成大块就盛出。",
      "补 1 勺油下番茄，中火炒到出汁、边缘塌软。",
      "加白糖和盐炒匀，倒回鸡蛋翻两下。",
      "撒葱花出锅，汤汁留着拌饭。"
    ],
    "minutes": 10,
    "servings": 2,
    "tags": ["快手", "清冰箱", "家常"],
    "difficulty": "简单"
  },
  {
    "id": "r_002",
    "title": "蒜蓉西兰花",
    "ingredients": [
      {"name": "西兰花", "qty": 1, "unit": "颗", "optional": false},
      {"name": "大蒜", "qty": 3, "unit": "瓣", "optional": false},
      {"name": "食用油", "qty": 2, "unit": "勺", "optional": false},
      {"name": "盐", "qty": 2, "unit": "克", "optional": true},
      {"name": "蚝油", "qty": 1, "unit": "勺", "optional": true}
    ],
    "steps": [
      "西兰花切小朵，淡盐水泡 5 分钟后冲净。",
      "水开加半勺盐，西兰花焯 40 秒后捞出沥干。",
      "热锅下油，小火把蒜末炒到微黄出香。",
      "转大火倒入西兰花翻炒 1 分钟，加蚝油和盐炒匀出锅。"
    ],
    "minutes": 12,
    "servings": 2,
    "tags": ["快手", "素食", "清冰箱"],
    "difficulty": "简单"
  },
  {
    "id": "r_003",
    "title": "菠菜蛋花汤",
    "ingredients": [
      {"name": "菠菜", "qty": 1, "unit": "把", "optional": false},
      {"name": "鸡蛋", "qty": 2, "unit": "个", "optional": false},
      {"name": "小葱", "qty": 1, "unit": "根", "optional": true},
      {"name": "食用油", "qty": 1, "unit": "勺", "optional": false},
      {"name": "盐", "qty": 2, "unit": "克", "optional": true},
      {"name": "香油", "qty": 3, "unit": "滴", "optional": true}
    ],
    "steps": [
      "菠菜洗净切段，开水焯 15 秒去掉草酸后捞出。",
      "锅中加 600 毫升水烧开，放盐和 1 勺油。",
      "鸡蛋打散，沿锅边细流淋入，静置 3 秒再轻推成蛋花。",
      "下菠菜煮 30 秒关火，撒葱花、滴香油。"
    ],
    "minutes": 10,
    "servings": 2,
    "tags": ["快手", "汤", "清冰箱"],
    "difficulty": "简单"
  },
  {
    "id": "r_004",
    "title": "麻婆豆腐",
    "ingredients": [
      {"name": "嫩豆腐", "qty": 1, "unit": "盒", "optional": false},
      {"name": "牛肉末", "qty": 100, "unit": "克", "optional": false},
      {"name": "大蒜", "qty": 2, "unit": "瓣", "optional": false},
      {"name": "生姜", "qty": 1, "unit": "块", "optional": false},
      {"name": "小葱", "qty": 1, "unit": "根", "optional": true},
      {"name": "生抽", "qty": 1, "unit": "勺", "optional": false},
      {"name": "食用油", "qty": 2, "unit": "勺", "optional": false},
      {"name": "豆瓣酱", "qty": 1, "unit": "勺", "optional": true},
      {"name": "花椒粉", "qty": 1, "unit": "克", "optional": true},
      {"name": "淀粉", "qty": 5, "unit": "克", "optional": true}
    ],
    "steps": [
      "豆腐切 2 厘米方块，放淡盐水里泡 5 分钟去豆腥。",
      "热锅下油，牛肉末炒散炒干，盛出一半备用。",
      "下姜蒜末和豆瓣酱小火炒出红油，加 200 毫升水烧开。",
      "轻轻推入豆腐，中小火煮 3 分钟，加生抽调味。",
      "淀粉加水调匀，分两次淋入勾薄芡。",
      "撒回牛肉末、花椒粉和葱花即可。"
    ],
    "minutes": 20,
    "servings": 2,
    "tags": ["下饭", "川味", "清冰箱"],
    "difficulty": "中等"
  },
  {
    "id": "r_005",
    "title": "香煎鸡胸肉",
    "ingredients": [
      {"name": "鸡胸肉", "qty": 1, "unit": "块", "optional": false},
      {"name": "大蒜", "qty": 2, "unit": "瓣", "optional": false},
      {"name": "生抽", "qty": 1, "unit": "勺", "optional": false},
      {"name": "食用油", "qty": 1, "unit": "勺", "optional": false},
      {"name": "黑胡椒", "qty": 1, "unit": "克", "optional": true},
      {"name": "淀粉", "qty": 5, "unit": "克", "optional": true}
    ],
    "steps": [
      "鸡胸横刀片成 1.5 厘米厚片，用刀背轻拍松。",
      "加蒜末、生抽、黑胡椒和淀粉抓匀，腌 10 分钟。",
      "平底锅刷薄油，中火每面煎 3 分钟。",
      "关火盖盖焖 2 分钟，切开无粉色即可。"
    ],
    "minutes": 15,
    "servings": 1,
    "tags": ["高蛋白", "快手", "低卡"],
    "difficulty": "简单"
  },
  {
    "id": "r_006",
